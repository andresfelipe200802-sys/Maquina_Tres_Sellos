# ── Backend (Node/Express + WebSocket) ─────────────────────────────────
# Copia este archivo como `server/.env`. El servidor carga `.env` desde su
# propio directorio de trabajo.
#
# NODE_ENV=production exige credenciales explícitas y desactiva los avisos de
# desarrollo. Úsalo=production cuando el backend sea visible desde internet
# (túnel de Cloudflare): además activa "trust proxy", sin el cual los límites
# de intentos de login se aplicarían como una sola bolsa para todos.
NODE_ENV=development
PORT=3001

# El backend solo escucha en esta PC por defecto (127.0.0.1); el único acceso
# externo es el túnel de Cloudflare. Pon HOST=0.0.0.0 SOLO si algún día
# quieres que los celulares se conecten directo por la Wi-Fi del salón.
HOST=127.0.0.1

# Orígenes exactos autorizados para CORS y WebSocket, separados por coma.
# Incluye el dominio de GitHub Pages en producción, por ejemplo:
# CLIENT_ORIGINS=https://usuario.github.io
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# Credenciales del instructor. En producción son obligatorias.
INSTRUCTOR_USER=instructor
INSTRUCTOR_PASSWORD=define-una-clave-larga-y-unica

# Persistencia opcional. Sin DATABASE_URL se usa memoria (los datos se pierden al reiniciar).
# Ejemplo: mysql://usuario:clave@localhost:3306/sena_agua
DATABASE_URL=
DB_SSL=false

# Límites y tiempos del protocolo. El servidor acota MAX_PLAYERS a 45.
MAX_PLAYERS=45
ROUND_SECONDS=900
DISCONNECT_GRACE_SECONDS=10

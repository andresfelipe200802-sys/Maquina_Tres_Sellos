{
  "name": "water-sample-puzzle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Sintetizador de Calibracion de Muestra de Agua - Juego funcional con arquitectura OO y patrones de diseno GoF.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "typecheck:server": "npm --prefix server run typecheck",
    "build:all": "npm run build && npm --prefix server run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "happy-dom": "^21.0.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
